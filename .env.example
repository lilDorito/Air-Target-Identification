# Copy to .env for local runs: uvicorn app.api.main:app --reload --env-file .env
# on Render set these in the dashboard instead. never commit .env

# 1 = public mode: role/type only, no aircraft names, no operator filter
# delete the line (or set 0) locally for the full version
FORCE_PUBLIC=1

# folder with <target>_<scenario>.txt + .json (default: models/)
# MODELS_DIR=models

# private CSV, full mode only (default: data_path in configs/experiment.yaml)
# DATA_PATH=data/targets.csv

# pages allowed to call the API: exact origin, comma-separated, no trailing slash
# not needed locally (npm run dev proxies /api), only when a page on another domain calls this API
CORS_ORIGINS=https://air-target-id.vercel.app
# also allow every per-deploy / branch URL of the Vercel project (the team suffix keeps others out)
# CORS_ORIGIN_REGEX=https://air-target-identification(-[a-z0-9-]+-lildoritos-projects)?\.vercel\.app

# Render build only: release asset with role_* / type_* models (scripts/fetch_models.py refuses aircraft_*)
# MODELS_URL=https://github.com/lilDorito/Air-Target-Identification/releases/download/models-v1/public_models.zip
